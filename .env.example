# Canonical public domain, without a trailing slash. Set before deployment.
NEXT_PUBLIC_SITE_URL=https://theshafterlawyer.com

# SMTP server credentials. These variables are server-only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Use a sender verified with your email provider.
SMTP_FROM=website@example.com
CONTACT_TO=contact@example.com
